# Normalise text files to LF in the repository, so the project behaves the
# same regardless of the OS it is cloned on.
* text=auto eol=lf

# Binary assets — prevent any line-ending conversion or text diffing.
*.pbix   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.zip    binary
*.xlsx   binary
*.docx   binary

# Language / config hints for nicer diffs and GitHub language stats.
*.md     text eol=lf
*.csv    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
